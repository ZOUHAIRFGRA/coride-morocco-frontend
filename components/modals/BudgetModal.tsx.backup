import React, { useState, useEffect } from "react";
import { View, Text, TextInput, TouchableOpacity, Modal, TouchableWithoutFeedback, Keyboard, ScrollView, BackHandler } from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { COLORS } from "@constants/theme";
import { widthPercentageToDP as wp } from "react-native-responsive-screen";
import PaymentMethodModal from "./PaymentMethodModal";
import CardModal from "./CardModal";
import { GradientButton } from "@/components/ui/buttons/GradientButton";
import Animated, { useSharedValue, useAnimatedStyle, withTiming, withSpring, runOnJS } from "react-native-reanimated";
import { Gesture, GestureDetector } from "react-native-gesture-handler";

type BudgetModalProps = {
  visible: boolean;
  onClose: () => void;
  onSave: (budgetData: { name: string; amount: string; account: string; range: "Daily" | "Weekly" | "Monthly" | "Quarterly" }) => void;
};

const BudgetModal: React.FC<BudgetModalProps> = ({ visible, onClose, onSave }) => {
  // State for form fields
  const [name, setName] = useState("");
  const [amount, setAmount] = useState("18000");
  const [account, setAccount] = useState("");
  const [range, setRange] = useState<"Daily" | "Weekly" | "Monthly" | "Quarterly">("Monthly");

  // State for modals
  const [paymentMethodVisible, setPaymentMethodVisible] = useState(false);
  const [cardModalVisible, setCardModalVisible] = useState(false);

  // State to track if modal is currently closing
  const [isClosing, setIsClosing] = useState(false);

  // State to track if modal is actually mounted
  const [isMounted, setIsMounted] = useState(false);

  // Animation value using Reanimated's useSharedValue
  const translateY = useSharedValue(500);

  // Create animated style using Reanimated
  const animatedStyle = useAnimatedStyle(() => {
    return {
      transform: [{ translateY: translateY.value }],
    };
  });

  // Reset closing state when modal opens
  useEffect(() => {
    if (visible && !isMounted) {
      setIsMounted(true);
      setIsClosing(false);
      // Reset animation value and animate modal in
      translateY.value = 500;
      translateY.value = withSpring(0, { damping: 20 });
    }
  }, [visible, isMounted]);

  // Handle back button press on Android
  useEffect(() => {
    const backHandler = BackHandler.addEventListener("hardwareBackPress", () => {
      if (visible && !isClosing) {
        closeModal();
        return true;
      }
      return false;
    });

    return () => backHandler.remove();
  }, [visible, isClosing]);

  // Function to close the modal with animation
  const closeModal = () => {
    if (isClosing) return; // Prevent multiple close attempts

    setIsClosing(true);
    Keyboard.dismiss();

    // Immediately hide payment method modal if it's open
    if (paymentMethodVisible) {
      setPaymentMethodVisible(false);
    }

    // Immediately hide card modal if it's open
    if (cardModalVisible) {
      setCardModalVisible(false);
    }

    // Animate modal out with Reanimated
    translateY.value = withTiming(500, { duration: 300 }, (finished) => {
      if (finished) {
        runOnJS(finishClosing)();
      }
    });
  };

  // Function to handle cleanup after animation
  const finishClosing = () => {
    // Reset form fields
    setName("");
    setAmount("18000");
    setAccount("");
    setRange("Monthly");

    // Unmount the modal completely
    setIsMounted(false);

    // Call the onClose prop after animation completes
    onClose();
  };

  // Configure the gesture handler for swipe gestures using Reanimated's gesture system
  const panGesture = Gesture.Pan()
    .onUpdate((event) => {
      // Only allow downward swipes
      if (event.translationY > 0) {
        translateY.value = event.translationY;
      }
    })
    .onEnd((event) => {
      // If the user swiped down more than 100 units, close the modal
      if (event.translationY > 100) {
        runOnJS(closeModal)();
      } else {
        // Otherwise, reset the position
        translateY.value = withSpring(0);
      }
    });

  // Function to handle saving the budget
  const handleSave = () => {
    if (isClosing) return; // Prevent action if already closing

    onSave({
      name,
      amount,
      account,
      range,
    });

    closeModal();
  };

  // Function to increment amount
  const incrementAmount = () => {
    const currentAmount = parseInt(amount) || 0;
    setAmount((currentAmount + 1000).toString());
  };

  // Function to decrement amount
  const decrementAmount = () => {
    const currentAmount = parseInt(amount) || 0;
    if (currentAmount >= 1000) {
      setAmount((currentAmount - 1000).toString());
    }
  };

  // Function to select a payment method
  const selectPaymentMethod = (method: string) => {
    if (method === "Credit card or debit card") {
      // Open the card modal when credit card is selected
      setPaymentMethodVisible(false);
      setTimeout(() => {
        setCardModalVisible(true);
      }, 300);
    } else {
      setAccount(method);
      setPaymentMethodVisible(false);
    }
  };

  // Function to open payment method modal
  const openPaymentMethodModal = () => {
    if (isClosing) return; // Prevent opening if modal is closing
    setPaymentMethodVisible(true);
  };

  // Function to handle adding a new card
  const handleAddCard = (cardData: { cardHolder: string; cardNumber: string; expiryDate: string; securityCode: string; country: string }) => {
    // Set the account to the card holder's name or a formatted card number
    const lastFourDigits = cardData.cardNumber.replace(/\s/g, "").slice(-4);
    setAccount(`Card •••• ${lastFourDigits}`);
    setCardModalVisible(false);
  };

  // Don't render anything if not visible or not mounted
  if (!visible || !isMounted) return null;

  return (
    <Modal visible={true} transparent animationType="none" onRequestClose={closeModal} statusBarTranslucent>
      <TouchableWithoutFeedback onPress={closeModal}>
        <View className="flex-1 bg-black/40 justify-end">
          <TouchableWithoutFeedback onPress={(e) => e.stopPropagation()}>
            <GestureDetector gesture={panGesture}>
              <Animated.View className="bg-white rounded-t-3xl overflow-hidden shadow-md relative" style={animatedStyle}>
                {/* Drag indicator */}
                <View className="w-full items-center pt-6 pb-2">
                  <View className="w-10 h-1 rounded-full bg-gray-200" />
                </View>

                {/* Close button */}
                <TouchableOpacity className="absolute top-6 right-4 z-10 p-2" onPress={closeModal} activeOpacity={0.7} disabled={isClosing}>
                  <Ionicons name="close" size={wp(6)} color="#666" />
                </TouchableOpacity>

                <ScrollView className="px-5 pb-4 md:pb-6" keyboardShouldPersistTaps="handled">
                  <Text className="text-2xl font-bold text-center text-gray-800 mb-1.5">Add a budget</Text>
                  <View className="h-px bg-gray-200 mb-6" />

                  {/* Name input */}
                  <TextInput
                    className="h-14 border font-regular border-gray-200 rounded-xl px-4 text-md text-gray-800 mb-6"
                    placeholder="Name"
                    value={name}
                    onChangeText={setName}
                    placeholderTextColor={COLORS.text.secondary}
                    editable={!isClosing}
                  />

                  {/* Amount input */}
                  <Text className="text-md text-gray-800 mb-4 font-regular">Select initial amount</Text>
                  <View className="flex-row items-center justify-between mb-6 border border-primary-oceanBlue700 rounded-3xl px-1 py-1">
                    <TouchableOpacity
                      className="w-12 h-12 rounded-full bg-primary-light justify-center items-center"
                      onPress={decrementAmount}
                      activeOpacity={0.7}
                      disabled={isClosing}
                    >
                      <Ionicons name="remove" size={wp(6)} color="#fff" />
                    </TouchableOpacity>
                    <View className="flex-row items-center justify-center">
                      <Text className="text-2xl font-semibold text-gray-800 mr-1">$</Text>
                      <Text className="text-2xl font-bold text-gray-800">{amount}</Text>
                    </View>
                    <TouchableOpacity
                      className="w-12 h-12 rounded-full bg-primary-light justify-center items-center"
                      onPress={incrementAmount}
                      activeOpacity={0.7}
                      disabled={isClosing}
                    >
                      <Ionicons name="add" size={wp(6)} color="#fff" />
                    </TouchableOpacity>
                  </View>

                  {/* Account selection */}
                  <TouchableOpacity
                    className="h-14 border border-gray-200 rounded-lg px-4 flex-row items-center justify-between mb-6 bg-blue-50"
                    onPress={openPaymentMethodModal}
                    activeOpacity={0.7}
                    disabled={isClosing}
                  >
                    <Text className={account ? "text-base font-regular text-gray-800" : "text-base text-gray-400"}>
                      {account || "Select an account"}
                    </Text>
                    <Ionicons name="chevron-down" size={wp(5)} color="#666" />
                  </TouchableOpacity>

                  {/* Range selection */}
                  <Text className="text-md text-gray-800 mb-4 font-regular">Select the range</Text>
                  <View className="flex-row flex-1 justify-between gap-2 mb-8">
                    {["Daily", "Weekly", "Monthly", "Quarterly"].map((item) => (
                      <TouchableOpacity
                        key={item}
                        className={`py-3 px-2 rounded-lg border flex-1 items-center ${
                          range === item ? "bg-primary-light border-primary-light" : "bg-white border-gray-200"
                        }`}
                        onPress={() => setRange(item as any)}
                        activeOpacity={0.7}
                        disabled={isClosing}
                      >
                        <Text className={`text-sm font-medium ${range === item ? "text-white font-semibold" : "text-gray-800"}`}>{item}</Text>
                      </TouchableOpacity>
                    ))}
                  </View>

                  {/* Save button with gradient */}
                  {!isClosing && (
                    <GradientButton
                      text="Save"
                      onPress={handleSave}
                      style={{ borderRadius: 8, paddingVertical: 16 }}
                      textStyle={{ fontSize: 16, fontWeight: "600", color: "#fff" }}
                    />
                  )}
                </ScrollView>
              </Animated.View>
            </GestureDetector>
          </TouchableWithoutFeedback>
        </View>
      </TouchableWithoutFeedback>

      {/* Payment Method Modal */}
      {paymentMethodVisible && !isClosing && (
        <PaymentMethodModal visible={true} onClose={() => setPaymentMethodVisible(false)} onSelect={selectPaymentMethod} />
      )}

      {/* Card Modal */}
      {cardModalVisible && !isClosing && <CardModal visible={true} onClose={() => setCardModalVisible(false)} onSave={handleAddCard} />}
    </Modal>
  );
};

export default BudgetModal;
