/**
 * Edit Transaction Modal
 * 
 * Modal for editing individual transactions within a journal entry.
 * Allows editing transaction details while maintaining double-entry accounting rules.
 * Uses the same structure as the create transaction flow.
 * 
 * @author VoxProfit Development Team
 * @version 1.0.0
 */

import React, { useState, useCallback, useEffect, useMemo } from "react";
import {
  View,
  Text,
  StyleSheet,
  Modal,
  TextInput,
  TouchableOpacity,
  ScrollView,
  Alert,
  KeyboardAvoidingView,
  Platform,
} from "react-native";
import { COLORS, FONTS } from "@/constants/theme";
import { widthPercentageToDP as wp, heightPercentageToDP as hp } from "react-native-responsive-screen";
import { Ionicons } from "@expo/vector-icons";
import { Transaction, Account } from "@/redux/bookkeeping/bookkeepingTypes";
import { useGetAllAccountsQuery } from "@/redux/bookkeeping/bookkeepingEndpoints";
import * as Haptics from "expo-haptics";

interface EditTransactionModalProps {
  visible: boolean;
  transaction: Transaction | null;
  selectedEntity: any; // Entity context for fetching accounts
  onClose: () => void;
  onSave: (updatedTransaction: Transaction) => void;
}

export default function EditTransactionModal({
  visible,
  transaction,
  selectedEntity,
  onClose,
  onSave,
}: EditTransactionModalProps) {
  const [description, setDescription] = useState("");
  const [amount, setAmount] = useState("");
  const [transactionType, setTransactionType] = useState<"debit" | "credit">("debit");
  const [selectedAccountUuid, setSelectedAccountUuid] = useState("");
  const [hasChanges, setHasChanges] = useState(false);
  const [showAccountDropdown, setShowAccountDropdown] = useState(false);
  const [showTransactionTypeDropdown, setShowTransactionTypeDropdown] = useState(false);
  const [accountSearchQuery, setAccountSearchQuery] = useState("");

  // Fetch accounts for the selected entity
  const entitySlug = useMemo(() => {
    console.log('🏢 [EDIT_TRANSACTION_MODAL] selectedEntity debug:', selectedEntity);
    console.log('🏢 [EDIT_TRANSACTION_MODAL] selectedEntity keys:', selectedEntity ? Object.keys(selectedEntity) : 'null');
    
    if (!selectedEntity) return "";
    
    // The entity from Redux state should have a slug property
    const slug = selectedEntity.slug || "";
    
    console.log('🏢 [EDIT_TRANSACTION_MODAL] Using entitySlug:', slug);
    return slug;
  }, [selectedEntity]);

  const { data: accountsData, isLoading: accountsLoading } = useGetAllAccountsQuery(
    { entitySlug },
    { skip: !entitySlug }
  );

  // Process accounts data
  const accounts = useMemo((): Account[] => {
    console.log('🏦 [EDIT_TRANSACTION_MODAL] Raw accounts data:', accountsData);
    
    // Handle GraphQL pagination structure with edges/nodes
    if (!accountsData?.edges) return [];
    
    const processedAccounts: Account[] = accountsData.edges.map((edge: any) => ({
      uuid: edge.node.uuid,
      name: edge.node.name,
      code: edge.node.code,
      role: edge.node.role,
      accountType: edge.node.accountType,
      displayName: edge.node.name, // Remove code from display name
      // Add account type properties for type detection
      isExpense: edge.node.isExpense,
      isAsset: edge.node.isAsset,
      isLiability: edge.node.isLiability,
      isIncome: edge.node.isIncome,
      isCapital: edge.node.isCapital,
      isCogs: edge.node.isCogs,
    }));
    
    console.log('🏦 [EDIT_TRANSACTION_MODAL] Processed accounts:', processedAccounts);
    return processedAccounts;
  }, [accountsData]);

  // Helper function to get account type display name
  const getAccountTypeDisplay = useCallback((account: Account): string => {
    if (account.isExpense || (account.role && account.role.includes('expense'))) return 'Expense';
    if (account.isAsset || (account.role && account.role.includes('asset'))) return 'Asset';
    if (account.isLiability || (account.role && account.role.includes('liability')) || (account.role && account.role.includes('lia_'))) return 'Liability';
    if (account.isIncome || (account.role && account.role.includes('income')) || (account.role && account.role.includes('revenue'))) return 'Income';
    if (account.isCapital || (account.role && account.role.includes('capital'))) return 'Capital';
    if (account.isCogs || (account.role && account.role.includes('cogs'))) return 'COGS';
    return 'Other'; // fallback
  }, []);

  // Filter accounts based on search query
  const filteredAccounts = useMemo(() => {
    if (!accountSearchQuery.trim()) return accounts;
    
    const query = accountSearchQuery.toLowerCase();
    return accounts.filter(account => 
      account.name.toLowerCase().includes(query) ||
      account.code.toLowerCase().includes(query) ||
      account.role.toLowerCase().includes(query)
    );
  }, [accounts, accountSearchQuery]);

  // Find selected account details
  const selectedAccount = useMemo((): Account | undefined => {
    return accounts.find((account: Account) => account.uuid === selectedAccountUuid);
  }, [accounts, selectedAccountUuid]);

  // Initialize form when transaction changes
  useEffect(() => {
    if (transaction) {
      console.log('🔧 [EDIT_TRANSACTION_MODAL] Initializing with transaction:', transaction);
      console.log('🔧 [EDIT_TRANSACTION_MODAL] Transaction debitAmount:', transaction.debitAmount);
      console.log('🔧 [EDIT_TRANSACTION_MODAL] Transaction creditAmount:', transaction.creditAmount);
      setDescription(transaction.description || "");
      
      // Set amount and transaction type
      const amount = Math.abs(parseFloat(transaction.amount?.toString() || "0") || 0);
      setAmount(amount.toString());
      
      // Determine transaction type from the transaction
      // Handle both txType formats (CREDIT/DEBIT vs credit/debit)
      let txType = transaction.txType?.toLowerCase();
      if (txType === 'credit' || txType === 'debit') {
        setTransactionType(txType as "debit" | "credit");
      } else if (transaction.debitAmount && transaction.debitAmount > 0) {
        setTransactionType("debit");
      } else if (transaction.creditAmount && transaction.creditAmount > 0) {
        setTransactionType("credit");
      } else {
        setTransactionType("debit"); // default
      }
      
      // Set account UUID - try to find matching account from accounts list
      console.log('🔧 [EDIT_TRANSACTION_MODAL] Transaction account info:', {
        accountName: transaction.accountName,
        accountCode: transaction.accountCode,
        accountUuid: transaction.accountUuid,
        uuid: transaction.uuid
      });
      
      setHasChanges(false);
    }
  }, [transaction]);

  // Separate effect to handle account matching when both transaction and accounts are available
  useEffect(() => {
    if (transaction && accounts.length > 0) {
      console.log('� [EDIT_TRANSACTION_MODAL] Matching account for transaction:', {
        transactionAccountName: transaction.accountName,
        transactionAccountCode: transaction.accountCode,
        availableAccounts: accounts.map(acc => ({ uuid: acc.uuid, name: acc.name, code: acc.code }))
      });

      // Try to find account by name or code
      const matchingAccount = accounts.find(account => 
        account.name === transaction.accountName || 
        account.code === transaction.accountCode
      );

      if (matchingAccount) {
        console.log('✅ [EDIT_TRANSACTION_MODAL] Found matching account:', matchingAccount);
        setSelectedAccountUuid(matchingAccount.uuid);
      } else {
        console.log('❌ [EDIT_TRANSACTION_MODAL] No matching account found, using accountUuid from transaction');
        setSelectedAccountUuid(transaction.accountUuid || "");
      }
    }
  }, [transaction, accounts]);

  /**
   * Handle input changes and mark as changed
   */
  const handleDescriptionChange = useCallback((text: string) => {
    setDescription(text);
    setHasChanges(true);
  }, []);

  const handleAmountChange = useCallback((text: string) => {
    // Only allow numbers and decimal point
    const cleanText = text.replace(/[^0-9.]/g, '');
    // Prevent multiple decimal points
    const parts = cleanText.split('.');
    if (parts.length > 2) return;
    
    setAmount(cleanText);
    setHasChanges(true);
  }, []);

  const handleTransactionTypeChange = useCallback((type: "debit" | "credit") => {
    setTransactionType(type);
    setShowTransactionTypeDropdown(false);
    setHasChanges(true);
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
  }, []);

  /**
   * Handle account selection
   */
  const handleAccountSelect = useCallback((account: Account) => {
    setSelectedAccountUuid(account.uuid);
    setShowAccountDropdown(false);
    setAccountSearchQuery(""); // Reset search when account is selected
    setHasChanges(true);
    Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
  }, []);

  /**
   * Validate form data
   */
  const validateForm = useCallback((): boolean => {
    if (!description.trim()) {
      Alert.alert("Validation Error", "Transaction description is required.");
      return false;
    }

    if (!selectedAccountUuid) {
      Alert.alert("Validation Error", "Please select an account.");
      return false;
    }

    const amountValue = parseFloat(amount) || 0;

    if (amountValue <= 0) {
      Alert.alert("Validation Error", "Amount must be greater than 0.");
      return false;
    }

    if (!transactionType) {
      Alert.alert("Validation Error", "Please select transaction type (Debit or Credit).");
      return false;
    }

    return true;
  }, [description, selectedAccountUuid, amount, transactionType]);

  /**
   * Handle save transaction
   */
  const handleSave = useCallback(() => {
    if (!validateForm() || !transaction) return;

    Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);

    const amountValue = parseFloat(amount) || 0;

    const updatedTransaction: Transaction = {
      ...transaction, // Preserve all original transaction data
      description: description.trim(),
      amount: amountValue, // Keep as number to match Transaction type
      txType: transactionType, // Keep lowercase to match Transaction type ('debit' | 'credit')
      accountUuid: selectedAccountUuid,
      accountName: selectedAccount?.name || transaction.accountName,
      accountCode: selectedAccount?.code || transaction.accountCode,
      accountRole: selectedAccount?.role || transaction.accountRole,
      // Also include debit/credit amounts for compatibility with new calculation logic
      debitAmount: transactionType === 'debit' ? amountValue : 0,
      creditAmount: transactionType === 'credit' ? amountValue : 0,
    };

    console.log('💾 [EDIT_TRANSACTION_MODAL] Original transaction:', transaction);
    console.log('💾 [EDIT_TRANSACTION_MODAL] Saving updated transaction:', updatedTransaction);
    onSave(updatedTransaction);
  }, [validateForm, transaction, description, amount, transactionType, selectedAccountUuid, selectedAccount, onSave]);

  /**
   * Handle close with unsaved changes warning
   */
  const handleClose = useCallback(() => {
    if (hasChanges) {
      Alert.alert(
        "Unsaved Changes",
        "You have unsaved changes. Are you sure you want to close without saving?",
        [
          {
            text: "Cancel",
            style: "cancel",
          },
          {
            text: "Discard",
            style: "destructive",
            onPress: () => {
              setHasChanges(false);
              onClose();
            },
          },
        ]
      );
    } else {
      onClose();
    }
  }, [hasChanges, onClose]);

  /**
   * Render account dropdown item
   */
  const renderAccountItem = useCallback((account: Account) => (
    <TouchableOpacity
      key={account.uuid}
      style={styles.accountItem}
      onPress={() => handleAccountSelect(account)}
    >
      <View style={styles.accountInfo}>
        <Text style={styles.accountName}>{account.name}</Text>
        <Text style={styles.accountDetails}>
          {getAccountTypeDisplay(account)}
        </Text>
      </View>
      {selectedAccountUuid === account.uuid && (
        <Ionicons name="checkmark-circle" size={wp(5)} color={COLORS.primary.oceanBlue700} />
      )}
    </TouchableOpacity>
  ), [selectedAccountUuid, handleAccountSelect, getAccountTypeDisplay]);

  if (!transaction) return null;

  return (
    <Modal
      visible={visible}
      animationType="slide"
      presentationStyle="pageSheet"
      onRequestClose={handleClose}
    >
      <KeyboardAvoidingView
        style={styles.container}
        behavior={Platform.OS === "ios" ? "padding" : "height"}
      >
        {/* Header */}
        <View style={styles.header}>
          <TouchableOpacity style={styles.closeButton} onPress={handleClose}>
            <Ionicons name="close" size={wp(6)} color={COLORS.text.secondary} />
          </TouchableOpacity>
          <Text style={styles.title}>Edit Transaction</Text>
          <TouchableOpacity 
            style={[styles.saveButton, !hasChanges && styles.saveButtonDisabled]} 
            onPress={handleSave}
            disabled={!hasChanges}
          >
            <Text style={[styles.saveButtonText, !hasChanges && styles.saveButtonTextDisabled]}>
              Save
            </Text>
          </TouchableOpacity>
        </View>

          <ScrollView style={styles.content} showsVerticalScrollIndicator={false}>
          {/* Description */}
          <View style={styles.section}>
            <Text style={styles.label}>Description *</Text>
            <TextInput
              style={styles.textInput}
              value={description}
              onChangeText={handleDescriptionChange}
              placeholder="Enter transaction description"
              placeholderTextColor={COLORS.text.tertiary}
              multiline
              numberOfLines={2}
            />
          </View>

          {/* Account Selection */}
          <View style={styles.section}>
            <Text style={styles.label}>Account *</Text>
            <TouchableOpacity
              style={styles.accountSelector}
              onPress={() => {
                const newDropdownState = !showAccountDropdown;
                setShowAccountDropdown(newDropdownState);
                // Reset search when closing dropdown
                if (!newDropdownState) {
                  setAccountSearchQuery("");
                }
              }}
              disabled={accountsLoading}
            >
              <View style={styles.accountSelectorContent}>
                {selectedAccount ? (
                  <View>
                    <Text style={styles.selectedAccountName}>{selectedAccount.name}</Text>
                    {/* <Text style={styles.selectedAccountDetails}>
                      {selectedAccount.code} • {selectedAccount.role}
                    </Text> */}
                  </View>
                ) : (
                  <Text style={styles.accountSelectorPlaceholder}>
                    {accountsLoading ? "Loading accounts..." : "Select an account"}
                  </Text>
                )}
              </View>
              <Ionicons 
                name={showAccountDropdown ? "chevron-up" : "chevron-down"} 
                size={wp(5)} 
                color={COLORS.text.secondary} 
              />
            </TouchableOpacity>

            {/* Account Dropdown */}
            {showAccountDropdown && (
              <View style={styles.accountDropdown}>
                {/* Search Input */}
                <View style={styles.searchContainer}>
                  <Ionicons name="search" size={wp(4)} color={COLORS.text.secondary} />
                  <TextInput
                    style={styles.searchInput}
                    value={accountSearchQuery}
                    onChangeText={setAccountSearchQuery}
                    placeholder="Search accounts..."
                    placeholderTextColor={COLORS.text.tertiary}
                  />
                  {accountSearchQuery.length > 0 && (
                    <TouchableOpacity onPress={() => setAccountSearchQuery("")}>
                      <Ionicons name="close-circle" size={wp(4)} color={COLORS.text.secondary} />
                    </TouchableOpacity>
                  )}
                </View>
                
                <ScrollView style={styles.accountList} nestedScrollEnabled>
                  {accountsLoading ? (
                    <View style={styles.loadingContainer}>
                      <Text style={styles.loadingText}>Loading accounts...</Text>
                    </View>
                  ) : filteredAccounts.length > 0 ? (
                    filteredAccounts.map(renderAccountItem)
                  ) : accountSearchQuery.length > 0 ? (
                    <View style={styles.emptyContainer}>
                      <Text style={styles.emptyText}>No accounts found matching "{accountSearchQuery}"</Text>
                    </View>
                  ) : (
                    <View style={styles.emptyContainer}>
                      <Text style={styles.emptyText}>No accounts available</Text>
                    </View>
                  )}
                </ScrollView>
              </View>
            )}
          </View>

          {/* Transaction Type Selection */}
          <View style={styles.section}>
            <Text style={styles.label}>Transaction Type *</Text>
            <TouchableOpacity
              style={styles.accountSelector}
              onPress={() => setShowTransactionTypeDropdown(!showTransactionTypeDropdown)}
            >
              <View style={styles.accountSelectorContent}>
                <Text style={styles.selectedAccountName}>
                  {transactionType === 'debit' ? 'Debit' : 'Credit'}
                </Text>
                <Text style={styles.selectedAccountDetails}>
                  {transactionType === 'debit' ? 'Money going out or expenses' : 'Money coming in or revenue'}
                </Text>
              </View>
              <Ionicons 
                name={showTransactionTypeDropdown ? "chevron-up" : "chevron-down"} 
                size={wp(5)} 
                color={COLORS.text.secondary} 
              />
            </TouchableOpacity>

            {/* Transaction Type Dropdown */}
            {showTransactionTypeDropdown && (
              <View style={styles.accountDropdown}>
                <TouchableOpacity
                  style={styles.accountItem}
                  onPress={() => handleTransactionTypeChange('debit')}
                >
                  <View style={styles.accountInfo}>
                    <Text style={styles.accountName}>Debit</Text>
                    <Text style={styles.accountDetails}>Money going out or expenses</Text>
                  </View>
                  {transactionType === 'debit' && (
                    <Ionicons name="checkmark-circle" size={wp(5)} color={COLORS.primary.oceanBlue700} />
                  )}
                </TouchableOpacity>
                <TouchableOpacity
                  style={styles.accountItem}
                  onPress={() => handleTransactionTypeChange('credit')}
                >
                  <View style={styles.accountInfo}>
                    <Text style={styles.accountName}>Credit</Text>
                    <Text style={styles.accountDetails}>Money coming in or revenue</Text>
                  </View>
                  {transactionType === 'credit' && (
                    <Ionicons name="checkmark-circle" size={wp(5)} color={COLORS.primary.oceanBlue700} />
                  )}
                </TouchableOpacity>
              </View>
            )}
          </View>

          {/* Amount */}
          <View style={styles.section}>
            <Text style={styles.label}>Amount *</Text>
            <View style={styles.amountInputContainer}>
              <Text style={styles.currencySymbol}>$</Text>
              <TextInput
                style={styles.amountInput}
                value={amount}
                onChangeText={handleAmountChange}
                placeholder="0.00"
                placeholderTextColor={COLORS.text.tertiary}
                keyboardType="decimal-pad"
              />
            </View>
          </View>

          {/* Transaction Preview */}
          <View style={styles.previewSection}>
            <Text style={styles.sectionTitle}>Preview</Text>
            <View style={styles.previewCard}>
              <View style={styles.previewRow}>
                <Text style={styles.previewLabel}>Account:</Text>
                <Text style={styles.previewValue}>
                  {selectedAccount?.displayName || "No account selected"}
                </Text>
              </View>
              <View style={styles.previewRow}>
                <Text style={styles.previewLabel}>Description:</Text>
                <Text style={styles.previewValue} numberOfLines={2}>
                  {description || "No description"}
                </Text>
              </View>
              <View style={styles.previewRow}>
                <Text style={styles.previewLabel}>Type:</Text>
                <Text style={[
                  styles.previewValue,
                  transactionType === 'debit' ? styles.debitText : styles.creditText
                ]}>
                  {transactionType?.toUpperCase() || "No type selected"}
                </Text>
              </View>
              <View style={styles.previewRow}>
                <Text style={styles.previewLabel}>Amount:</Text>
                <Text style={styles.previewValue}>
                  ${amount || "0.00"}
                </Text>
              </View>
            </View>
          </View>

          {/* Bottom spacing */}
          <View style={{ height: hp(10) }} />
        </ScrollView>
      </KeyboardAvoidingView>
    </Modal>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: "#f5f5f5",
  },
  header: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    paddingHorizontal: wp(4),
    paddingTop: hp(2),
    paddingBottom: hp(2),
    backgroundColor: "#fff",
    borderBottomWidth: 1,
    borderBottomColor: COLORS.border.primary,
  },
  closeButton: {
    padding: wp(2),
  },
  title: {
    fontSize: hp(2.2),
    fontFamily: FONTS.bold,
    color: COLORS.text.primary,
  },
  saveButton: {
    backgroundColor: COLORS.primary.oceanBlue700,
    paddingHorizontal: wp(4),
    paddingVertical: hp(1),
    borderRadius: wp(2),
  },
  saveButtonDisabled: {
    backgroundColor: COLORS.border.secondary,
  },
  saveButtonText: {
    color: "#fff",
    fontFamily: FONTS.semiBold,
    fontSize: hp(1.6),
  },
  saveButtonTextDisabled: {
    color: COLORS.text.tertiary,
  },
  content: {
    flex: 1,
    paddingHorizontal: wp(4),
  },
  section: {
    marginTop: hp(3),
  },
  sectionTitle: {
    fontSize: hp(2),
    fontFamily: FONTS.bold,
    color: COLORS.text.primary,
    marginBottom: hp(1.5),
  },
  label: {
    fontSize: hp(1.6),
    fontFamily: FONTS.semiBold,
    color: COLORS.text.primary,
    marginBottom: hp(1),
  },
  textInput: {
    backgroundColor: "#fff",
    borderWidth: 1,
    borderColor: COLORS.border.primary,
    borderRadius: wp(3),
    paddingHorizontal: wp(4),
    paddingVertical: hp(1.5),
    fontSize: hp(1.8),
    fontFamily: FONTS.regular,
    color: COLORS.text.primary,
    textAlignVertical: "top",
  },
  accountSelector: {
    backgroundColor: "#fff",
    borderWidth: 1,
    borderColor: COLORS.border.primary,
    borderRadius: wp(3),
    paddingHorizontal: wp(4),
    paddingVertical: hp(1.5),
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
  },
  accountSelectorContent: {
    flex: 1,
  },
  selectedAccountName: {
    fontSize: hp(1.8),
    fontFamily: FONTS.semiBold,
    color: COLORS.text.primary,
  },
  selectedAccountDetails: {
    fontSize: hp(1.5),
    fontFamily: FONTS.regular,
    color: COLORS.text.secondary,
    marginTop: hp(0.3),
  },
  accountSelectorPlaceholder: {
    fontSize: hp(1.8),
    fontFamily: FONTS.regular,
    color: COLORS.text.tertiary,
  },
  accountDropdown: {
    backgroundColor: "#fff",
    borderWidth: 1,
    borderColor: COLORS.border.primary,
    borderRadius: wp(3),
    marginTop: hp(1),
    maxHeight: hp(25),
  },
  searchContainer: {
    flexDirection: "row",
    alignItems: "center",
    paddingHorizontal: wp(3),
    paddingVertical: hp(1),
    borderBottomWidth: 1,
    borderBottomColor: COLORS.border.primary,
    backgroundColor: "#f8f9fa",
  },
  searchInput: {
    flex: 1,
    fontSize: hp(1.6),
    fontFamily: FONTS.regular,
    color: COLORS.text.primary,
    marginLeft: wp(2),
    marginRight: wp(2),
    paddingVertical: hp(0.5),
  },
  accountList: {
    maxHeight: hp(20),
  },
  accountItem: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
    paddingHorizontal: wp(4),
    paddingVertical: hp(1.5),
    borderBottomWidth: 1,
    borderBottomColor: COLORS.border.primary,
  },
  accountInfo: {
    flex: 1,
  },
  accountName: {
    fontSize: hp(1.7),
    fontFamily: FONTS.semiBold,
    color: COLORS.text.primary,
  },
  accountDetails: {
    fontSize: hp(1.4),
    fontFamily: FONTS.regular,
    color: COLORS.text.secondary,
    marginTop: hp(0.3),
  },
  loadingContainer: {
    padding: wp(4),
    alignItems: "center",
  },
  loadingText: {
    fontSize: hp(1.6),
    fontFamily: FONTS.regular,
    color: COLORS.text.secondary,
  },
  emptyContainer: {
    padding: wp(4),
    alignItems: "center",
  },
  emptyText: {
    fontSize: hp(1.6),
    fontFamily: FONTS.regular,
    color: COLORS.text.secondary,
  },
  amountInputContainer: {
    flexDirection: "row",
    alignItems: "center",
    backgroundColor: "#fff",
    borderWidth: 1,
    borderColor: COLORS.border.primary,
    borderRadius: wp(3),
    paddingHorizontal: wp(3),
    paddingVertical: hp(1.5),
  },
  currencySymbol: {
    fontSize: hp(1.8),
    fontFamily: FONTS.semiBold,
    color: COLORS.text.primary,
    marginRight: wp(2),
  },
  amountInput: {
    flex: 1,
    fontSize: hp(1.8),
    fontFamily: FONTS.regular,
    color: COLORS.text.primary,
  },
  previewSection: {
    marginTop: hp(4),
  },
  previewCard: {
    backgroundColor: "#fff",
    borderRadius: wp(3),
    padding: wp(4),
    borderWidth: 1,
    borderColor: COLORS.border.primary,
  },
  previewRow: {
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "flex-start",
    marginBottom: hp(1),
  },
  previewLabel: {
    fontSize: hp(1.6),
    fontFamily: FONTS.semiBold,
    color: COLORS.text.secondary,
    flex: 0.4,
  },
  previewValue: {
    fontSize: hp(1.6),
    fontFamily: FONTS.regular,
    color: COLORS.text.primary,
    flex: 0.6,
    textAlign: "right",
  },
  debitText: {
    color: COLORS.success.dark,
  },
  creditText: {
    color: COLORS.error.dark,
  },
});
