{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "set DARK_MODE=media && expo run:android",
    "ios": "set DARK_MODE=media && expo run:ios",
    "web": "set DARK_MODE=media && expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|@gluestack-ui|@reduxjs/toolkit|react-redux)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.{js,jsx,ts,tsx}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/android/**",
      "!**/ios/**",
      "!**/*.config.js",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/actionsheet": "^0.2.53",
    "@gluestack-ui/button": "^1.0.14",
    "@gluestack-ui/fab": "^0.1.28",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/menu": "^0.2.43",
    "@gluestack-ui/modal": "^0.1.41",
    "@gluestack-ui/nativewind-utils": "^1.0.26",
    "@gluestack-ui/overlay": "^0.1.22",
    "@gluestack-ui/select": "^0.1.31",
    "@gluestack-ui/toast": "^1.0.9",
    "@iconify-json/material-symbols": "^1.2.42",
    "@legendapp/motion": "^2.4.0",
    "@monicon/metro": "^1.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@reduxjs/toolkit": "^2.6.1",
    "@rtk-query/graphql-request-base-query": "^2.3.1",
    "@types/react-native-modal": "^3.1.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~8.0.1",
    "expo": "~54.0.27",
    "expo-asset": "~12.0.11",
    "expo-audio": "~1.0.16",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "gluestack-ui": "^0.7.22",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "graphql-tag": "^2.12.6",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-country-picker-modal-v2": "^2.0.9",
    "react-native-css-interop": "^0.1.22",
    "react-native-date-picker": "^5.0.1",
    "react-native-gesture-handler": "~2.28.0",
