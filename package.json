    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@iconify-json/arcticons": "^1.2.21",
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/json": "^2.2.321",
