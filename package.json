{
  "name": "app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "set DARK_MODE=media && expo run:android",
    "ios": "set DARK_MODE=media && expo run:ios",
    "web": "set DARK_MODE=media && expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|react-clone-referenced-element|@react-native-community|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|@gluestack-ui|@reduxjs/toolkit|react-redux)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.{js,jsx,ts,tsx}",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/android/**",
      "!**/ios/**",
      "!**/*.config.js",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 70,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/actionsheet": "^0.2.53",
    "@gluestack-ui/button": "^1.0.14",
    "@gluestack-ui/fab": "^0.1.28",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/menu": "^0.2.43",
    "@gluestack-ui/modal": "^0.1.41",
    "@gluestack-ui/nativewind-utils": "^1.0.26",
    "@gluestack-ui/overlay": "^0.1.22",
    "@gluestack-ui/select": "^0.1.31",
    "@gluestack-ui/toast": "^1.0.9",
    "@iconify-json/material-symbols": "^1.2.42",
    "@legendapp/motion": "^2.4.0",
    "@monicon/metro": "^1.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@reduxjs/toolkit": "^2.6.1",
    "@rtk-query/graphql-request-base-query": "^2.3.1",
    "@types/react-native-modal": "^3.1.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~8.0.1",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
